# Copy this file to ".env" and fill in your values:   cp .env.example .env
# ".env" is listed in .gitignore - never commit it, never paste real keys here.

# --- Provider -------------------------------------------------------------
# "deepl"     -> DeepL API (needs DEEPL_API_KEY, supports auto language detection)
# "mymemory"  -> MyMemory (no key needed, smaller free limits, no auto-detect)
# Leave empty to auto-pick: DeepL if DEEPL_API_KEY is set, otherwise MyMemory.
TRANSLATION_PROVIDER=deepl

# --- DeepL ------------------------------------------------------------------
# Get a key: https://www.deepl.com/pro-api  (choose "DeepL API Free")
# Find it at: https://www.deepl.com/your-account/keys
# Free keys end in ":fx" and automatically use https://api-free.deepl.com
DEEPL_API_KEY=
# Optional override (normally not needed):
# DEEPL_API_URL=https://api-free.deepl.com

# --- MyMemory (optional) ------------------------------------------------------
# A valid email raises the documented free daily limit (5,000 -> 50,000 chars/day).
MYMEMORY_EMAIL=

# --- App settings -------------------------------------------------------------
MAX_CHARS=5000
RATE_LIMIT_PER_MIN=30
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
